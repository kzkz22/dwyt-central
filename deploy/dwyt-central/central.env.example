# /etc/dwyt-central/central.env  (chmod 600, owner root). Read by the service and dwyt-central-cli.

# PostgreSQL in this LXC, Unix socket + peer authentication (pg_ident map, see docs/telepites.md):
# the app role is subject to row-level security; the owner role runs migrations and system code.
DATABASE_URL=postgresql+psycopg://dwyt_app@/dwyt
DATABASE_SYSTEM_URL=postgresql+psycopg://dwyt@/dwyt
APP_DB_ROLE=dwyt_app

# The public address (Google redirect and invitation links use it)
BASE_URL=https://dwyt.iodate.date
COOKIE_SECURE=true
# Apache's address: only it may set the client IP and the scheme (uvicorn reads this variable)
FORWARDED_ALLOW_IPS=APACHE-IP
TIMEZONE=Europe/Budapest

# Registration: invite (default) | open | closed
REGISTRATION=invite
INVITE_DAYS=7
SESSION_DAYS=30

# Google sign-in: OAuth client of type "Web application" (docs/telepites.md, step 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runner protocol (defaults are fine)
# LEASE_S=900
# CLAIM_WAIT_S=25
# JOB_MAX_ATTEMPTS=6

# Search (round 3): the embedding service on this machine (dwyt-central-embed); empty = text search only
EMBED_URL=http://127.0.0.1:8001
# EMBED_MODEL=BAAI/bge-m3
# EMBED_THREADS=2
# SEARCH_MIN_SIMILARITY=0.45

# Own recordings and quotas (round 3b); the admin can override the two MB limits per user
# STAGING_DIR=/var/lib/dwyt/staging
# UPLOAD_MAX_MB=2000
# UPLOAD_PENDING_MAX=2
# UPLOAD_KEEP_DAYS=7
# STORAGE_QUOTA_MB=2048

# YouTube subscriptions (round 4). TOKEN_KEY encrypts the users' YouTube refresh tokens; make one with
#   /opt/dwyt-central/venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty: connecting a YouTube account is off (Takeout and manual channels still work). Losing it = reconnect.
TOKEN_KEY=
# FEED_POLL_MIN=60
# GOOGLE_SYNC_HOURS=24
# a subscription video without captions waits this long for the user's GPU, then the next step (cloud if allowed)
# GPU_WAIT_H=72

# Notifications (round 4b): users pick ntfy or Home Assistant on their Settings page. Their addresses may not
# point into private networks, except these (comma-separated CIDRs; admins may always use them), e.g. your LAN:
# NOTIFY_PRIVATE_NETS=192.168.1.0/24
