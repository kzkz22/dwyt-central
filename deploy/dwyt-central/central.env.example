# /etc/dwyt-central/central.env  (chmod 600, owner root). Read by the service and dwyt-central-cli.

# PostgreSQL in this LXC, Unix socket + peer authentication (pg_ident map, see docs/telepites.md):
# the app role is subject to row-level security; the owner role runs migrations and system code.
DATABASE_URL=postgresql+psycopg://dwyt_app@/dwyt
DATABASE_SYSTEM_URL=postgresql+psycopg://dwyt@/dwyt
APP_DB_ROLE=dwyt_app

# The public address (Google redirect and invitation links use it)
BASE_URL=https://dwyt.iodate.date
COOKIE_SECURE=true
# Apache's address: only it may set the client IP and the scheme (uvicorn reads this variable)
FORWARDED_ALLOW_IPS=APACHE-IP
TIMEZONE=Europe/Budapest

# Registration: invite (default) | open | closed
REGISTRATION=invite
INVITE_DAYS=7
SESSION_DAYS=30

# Google sign-in: OAuth client of type "Web application" (docs/telepites.md, step 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runner protocol (defaults are fine)
# LEASE_S=900
# CLAIM_WAIT_S=25
# JOB_MAX_ATTEMPTS=6
